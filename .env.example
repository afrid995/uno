# UNO Ultimate - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Environment
NODE_ENV=development
PORT=4000
VITE_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uno_ultimate?schema=public

# Session & Security Settings
SESSION_SECRET=dev_session_secret_replace_with_secure_random_hex_in_production
SESSION_EXPIRATION_HOURS=24
COOKIE_SECRET=dev_cookie_secret_replace_with_secure_random_hex_in_production
COOKIE_NAME=uno_session

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GUEST=30

# Test Helper Settings (Non-production only; disabled by default)
# When ENABLE_TEST_HELPERS is 'true', TEST_HELPER_SECRET must be configured with at least 16 characters.
# Playwright automatically generates a temporary secret for its E2E server instances.
# ENABLE_TEST_HELPERS=false
# TEST_HELPER_SECRET=test_secret_placeholder_min_16_chars_do_not_commit_real_secret

