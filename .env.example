# ==============================================================================
# UNO Ultimate — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development, or configure these variables
# directly in your production hosting dashboards (Vercel & Render).
#
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Settings (Render / Backend)
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Server port (Render sets this dynamically, defaulting to 10000 on Render)
PORT=4000

# Allowed CORS origins for Express API and Socket.IO.
# Supports comma-separated origins and wildcards (e.g. 'https://your-app.vercel.app,https://*.vercel.app').
# In local development: 'http://localhost:5173'
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL: Neon Free Tier or Managed Postgres)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection string (include ?sslmode=require for cloud databases).
# For Neon Free Tier (₹0/month):
# Copy your connection string from the Neon Console (uncheck "Pooled connection"
# to obtain the direct connection URL that supports Prisma migrations):
# e.g.: postgresql://alex:secret@ep-cool-frog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uno_ultimate?schema=public

# Optional direct connection URL for connection-pooled databases (e.g. Supabase / Neon with PgBouncer)
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/uno_ultimate?schema=public

# ------------------------------------------------------------------------------
# 3. Security & Session Secrets (Render / Backend)
# ------------------------------------------------------------------------------
# High-entropy cryptographic secrets (at least 32 random characters recommended).
# On Render, these can be automatically generated using generateValue: true.
SESSION_SECRET=dev_session_secret_replace_with_secure_random_hex_in_production
COOKIE_SECRET=dev_cookie_secret_replace_with_secure_random_hex_in_production
COOKIE_NAME=uno_session
SESSION_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# 4. Rate Limiting (Render / Backend)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GUEST=60

# ------------------------------------------------------------------------------
# 5. Frontend Client Settings (Vercel / Frontend)
# ------------------------------------------------------------------------------
# Backend API URL (e.g. 'https://uno-ultimate-server.onrender.com' in production).
# Leave empty or set to 'http://localhost:4000' in local development.
VITE_API_URL=http://localhost:4000

# Backend WebSocket URL (e.g. 'https://uno-ultimate-server.onrender.com' in production).
# When omitted, VITE_API_URL is used automatically.
VITE_WS_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 6. Test Helper Settings (Non-production only; strictly disabled in production)
# ------------------------------------------------------------------------------
ENABLE_TEST_HELPERS=false
# TEST_HELPER_SECRET=test_secret_placeholder_min_16_chars_do_not_commit_real_secret
